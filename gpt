class PollinationsClient:

    def __init__(self, model: str = DEFAULT_MODEL, timeout: int = DEFAULT_TIMEOUT):

        self.model = model

        self.timeout = timeout

        self.request_count = 0

        self.error_count = 0

        self.lock = threading.Lock()



    def _build_url(self, prompt: str) -> str:

        encoded_prompt = urllib.parse.quote(prompt)

        return f"{API_BASE_URL}{encoded_prompt}?model={self.model}"



    def query(self, prompt: str, use_cache: bool = True) -> str:

        if use_cache:

            cached = CACHE.get(prompt)

            if cached:

                LOGGER.info(f"Cache hit for prompt: {prompt[:50]}")

                return cached



        with self.lock:

            self.request_count += 1



        url = self._build_url(prompt)

        headers = {

            "User-Agent": f"NexusUltimate/{VERSION}",

            "Accept": "text/plain"

        }



        def _do_request():

            req = urllib.request.Request(url, headers=headers)

            with urllib.request.urlopen(req, timeout=self.timeout) as response:

                return response.read().decode("utf-8", errors="ignore").strip()



        try:

            result = retry_on_failure(_do_request)

            if use_cache and result and not result.startswith("[Erreur"):

                CACHE.set(prompt, result)

            return result

        except urllib.error.HTTPError as e:

            with self.lock:

                self.error_count += 1

            LOGGER.error(f"HTTP Error {e.code} for prompt: {prompt[:50]}")

            return f"[Erreur HTTP {e.code}] Le serveur Pollinations a refusé la requête."

        except urllib.error.URLError as e:

            with self.lock:

                self.error_count += 1

            LOGGER.error(f"URL Error: {e.reason}")

            return f"[Erreur Réseau] Impossible de joindre Pollinations: {e.reason}"

        except socket.timeout:

            with self.lock:

                self.error_count += 1

            LOGGER.error("Request timeout")

            return "[Erreur Timeout] Le serveur n'a pas répondu à temps."

        except Exception as e:

            with self.lock:

                self.error_count += 1

            LOGGER.error(f"Unexpected error: {str(e)}")

            return f"[Erreur Inattendue] {str(e)[:150]}"



    def query_with_context(self, prompt: str, context: str) -> str:

        if context:

            full_prompt = f"Voici le contexte de notre conversation:\n{context}\n\nNouvelle question: {prompt}"

        else:

            full_prompt = prompt

        return self.query(full_prompt)



    def get_stats(self) -> Dict[str, Any]:

        with self.lock:

            return {

                "model": self.model,

                "requests": self.request_count,

                "errors": self.error_count,

                "success_rate": round((1 - self.error_count / max(1, self.request_count)) * 100, 2)

            }



    def switch_model(self, new_model: str):

        if new_model in AVAILABLE_MODELS:

            with self.lock:

                self.model = new_model

            LOGGER.info(f"Model switched to: {new_model}")

            return True

        return False



