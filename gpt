class ModelRouter:

    def __init__(self, client: PollinationsClient):

        self.client = client

        self.routing_rules = {

            "fast": ["openai-fast"],

            "default": ["openai"],

            "powerful": ["mistral", "llama"]

        }



    def select_model(self, prompt: str, mode: str = "default") -> str:

        intent = PromptAnalyzer.analyze(prompt)



        if mode == "fast":

            return random.choice(self.routing_rules["fast"])

        elif mode == "powerful":

            return random.choice(self.routing_rules["powerful"])



        if intent["has_code"]:

            return "mistral"

        elif intent["is_error"]:

            return "openai"

        elif len(prompt) > 500:

            return "mistral"

        else:

            return "openai"



    def query_with_routing(self, prompt: str, mode: str = "default") -> str:

        selected_model = self.select_model(prompt, mode)

        original_model = self.client.model

        self.client.switch_model(selected_model)

        try:

            response = self.client.query(prompt)

        finally:

            self.client.switch_model(original_model)

        return response



