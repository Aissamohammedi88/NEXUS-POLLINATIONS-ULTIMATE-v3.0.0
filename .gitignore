# ═══════════════════════════════════════════════════════════════════════════════
# NEXUS POLLINATIONS ULTIMATE — .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# --- Sessions & Cache local (Généré à l'exécution) ---
NexusUltimate/
*.session.json
cache/
sessions/
logs/
*.log
*.tmp
*.bak

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/

# --- Secrets ---
.env
.env.*
!.env.example
credentials.json

# --- OS & IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
