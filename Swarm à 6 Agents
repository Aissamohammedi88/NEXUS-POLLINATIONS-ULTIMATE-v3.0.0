class AgentBase:
def __init__(self, name: str, system_prompt: str):
self.name = name
self.system_prompt = system_prompt
self.client = PollinationsClient()

def run(self, prompt: str) -> Dict[str, Any]:
full_prompt = f"{self.system_prompt}\n\n---\nQuestion de l'utilisateur :\n{prompt}"
t0 = time.time()
response = self.client.query(full_prompt)
duration = time.time() - t0
return {
"agent": self.name,
"response": response,
"duration_ms": round(duration * 1000, 2),
"success": not response.startswith("[Erreur")
}

