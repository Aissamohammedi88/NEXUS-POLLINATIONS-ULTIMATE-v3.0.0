class JudgeAgent:
def __init__(self):
self.client = PollinationsClient()

def judge(self, user_prompt: str, agent_results: List[Dict]) -> Dict[str, Any]:
successful = [r for r in agent_results if r["success"]]
failed = [r for r in agent_results if not r["success"]]

if not successful:
return {
"verdict": "ÉCHEC TOTAL",
"response": "Aucun agent n'a pu répondre.",
"confidence": 0.0,
"sources": [],
"failed_agents": [f["agent"] for f in failed]
}

synthesis_prompt = f"""Tu es le Judge Suprême. Tu reçois les réponses de {len(successful)} agents experts pour la question suivante :

QUESTION : {user_prompt}

Réponses des agents :
"""
for i, r in enumerate(successful, 1):
synthesis_prompt += f"\n--- Agent {i} ({r['agent']}) ---\n{r['response']}\n"

synthesis_prompt += """
---
Ta mission :
1. Fusionne les meilleures parties de chaque réponse.
2. Élimine les contradictions et les erreurs.
3. Produis une réponse finale, claire, complète et fiable.
4. Sois direct et technique.
"""

t0 = time.time()
final_response = self.client.query(synthesis_prompt)
duration = time.time() - t0

confidence = min(1.0, len(successful) / 6.0)

return {
"verdict": "SUCCÈS" if confidence >= 0.6 else "PARTIEL",
"response": final_response,
"confidence": round(confidence, 2),
"sources": [r["agent"] for r in successful],
"failed_agents": [f["agent"] for f in failed],
"duration_ms": round(duration * 1000, 2)
}

