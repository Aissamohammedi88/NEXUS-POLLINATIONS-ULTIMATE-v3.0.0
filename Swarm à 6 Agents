context = self.memory.get_context()
response = self.client.query_with_context(user_input, context)
print(f"\r{TerminalColors.MAGENTA}🧬 NEXUS :{TerminalColors.RESET} {response}\n")

self.memory.add("user", user_input)
self.memory.add("assistant", response)

except KeyboardInterrupt:
print(f"\n{TerminalColors.RED}Interrompu par l'utilisateur.{TerminalColors.RESET}")
self.running = False
except Exception as e:
LOGGER.error(f"CLI Error: {e}")
print(f"\n{TerminalColors.RED}Erreur: {e}{TerminalColors.RESET}")

def handle_command(self, cmd: str):
parts = cmd.split()
command = parts[0].lower()

if command == "/quit":
print(f"{TerminalColors.YELLOW}👋 Fermeture de l'agent.{TerminalColors.RESET}")
self.running = False
elif command == "/clear":
self.memory.clear()
print(f"{TerminalColors.GREEN}✅ Historique effacé.{TerminalColors.RESET}\n")
elif command == "/help":
self.print_help()
elif command == "/model":
if len(parts) > 1:
if self.client.switch_model(parts[1]):
print(f"{TerminalColors.GREEN}✅ Modèle changé: {parts[1]}{TerminalColors.RESET}\n")
else:
print(f"{TerminalColors.RED}❌ Modèle invalide. Choix: {', '.join(AVAILABLE_MODELS)}{TerminalColors.RESET}\n")
else:
print(f"{TerminalColors.YELLOW}Modèle actuel: {self.client.model}{TerminalColors.RESET}\n")
elif command == "/stats":
print(f"{TerminalColors.CYAN}{json.dumps(self.client.get_stats(), indent=2)}{TerminalColors.RESET}\n")
elif command == "/cache":
print(f"{TerminalColors.CYAN}{json.dumps(CACHE.stats(), indent=2)}{TerminalColors.RESET}\n")
elif command == "/save":
self.memory.save(self.session_file)
print(f"{TerminalColors.GREEN}✅ Session sauvegardée: {self.session_file}{TerminalColors.RESET}\n")
elif command == "/load":
self.memory.load(self.session_file)
print(f"{TerminalColors.GREEN}✅ Session chargée: {len(self.memory.messages)} messages{TerminalColors.RESET}\n")
elif command == "/report":
report_path = ReportGenerator.generate_json_report(self.memory, self.client.get_stats())
print(f"{TerminalColors.GREEN}✅ Rapport JSON: {report_path}{TerminalColors.RESET}\n")
elif command == "/html":
report_path = ReportGenerator.generate_html_report(self.memory, self.client.get_stats())
print(f"{TerminalColors.GREEN}✅ Rapport HTML: {report_path}{TerminalColors.RESET}\n")
elif command == "/server":
print(f"{TerminalColors.CYAN}🌐 Démarrage du serveur HTTP...{TerminalColors.RESET}")
threading.Thread(target=start_server, daemon=True).start()
print(f"{TerminalColors.GREEN}✅ Serveur lancé. Port: {SERVER_PORT}{TerminalColors.RESET}\n")
elif command == "/swarm":
swarm_prompt = " ".join(parts[1:])
if not swarm_prompt:
print(f"{TerminalColors.RED}❌ Usage: /swarm <texte>{TerminalColors.RESET}\n")
return
print(f"{TerminalColors.CYAN}⏳ Swarm à 6 agents en action...{TerminalColors.RESET}")
result = SWARM.run(swarm_prompt)
print(f"\n{TerminalColors.MAGENTA}⚖️ JUDGE ({result['judge_verdict']['verdict']}, confiance: {result['judge_verdict']['confidence']}) :{TerminalColors.RESET}")
print(f"{result['judge_verdict']['response']}\n")
print(f"{TerminalColors.DIM}Agents: {', '.join(result['judge_verdict']['sources'])}{TerminalColors.RESET}\n")
else:
print(f"{TerminalColors.RED}Commande inconnue: {cmd}{TerminalColors.RESET}\n")

def main():
if len(sys.argv) > 1 and sys.argv[1] == "--server":
start_server()
else:
cli = NexusCLI()
cli.run()

if __name__ == "__main__":
main()
