class PromptAnalyzer:
PATTERNS = {
"question": [r"\?", r"comment", r"pourquoi", r"quel", r"quelle", r"qui", r"quand", r"où"],
"command": [r"^(fais|crée|génère|écris|construis|supprime|efface)", r"^(ajoute|modifie|change)"],
"code": [r"def ", r"class ", r"import ", r"function ", r"const ", r"let ", r"var "],
"url": [r"https?://", r"www\.", r"\.com", r"\.org", r"\.io"],
"error": [r"erreur", r"error", r"bug", r"exception", r"traceback", r"fail"],
}

@classmethod
def analyze(cls, prompt: str) -> Dict[str, Any]:
prompt_lower = prompt.lower()
intent = {
"type": "unknown",
"confidence": 0.0,
"language": "fr",
"has_code": False,
"has_url": False,
"is_error": False
}

for intent_type, patterns in cls.PATTERNS.items():
for pattern in patterns:
if re.search(pattern, prompt_lower, re.IGNORECASE):
if intent_type == "question":
intent["type"] = "question"
intent["confidence"] = max(intent["confidence"], 0.7)
elif intent_type == "command":
intent["type"] = "command"
intent["confidence"] = max(intent["confidence"], 0.9)
elif intent_type == "code":
intent["has_code"] = True
elif intent_type == "url":
intent["has_url"] = True
elif intent_type == "error":
intent["is_error"] = True

if not intent["type"] == "unknown" and intent["confidence"] < 0.5:
intent["type"] = "question"

return intent

@classmethod
def extract_language(cls, prompt: str) -> str:
english_words = ["the", "and", "is", "are", "was", "were", "have", "has", "will", "would", "can", "could", "should", "hello", "hi", "yes", "no"]
french_words = ["le", "la", "les", "et", "est", "sont", "était", "étaient", "avoir", "a", "va", "voudrais", "peut", "pourrais", "devrais", "bonjour", "salut", "oui", "non"]

prompt_lower = prompt.lower()
en_count = sum(1 for w in english_words if w in prompt_lower)
fr_count = sum(1 for w in french_words if w in prompt_lower)

if en_count > fr_count:
return "en"
return "fr"

