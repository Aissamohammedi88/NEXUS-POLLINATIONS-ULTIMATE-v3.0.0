class NexusHTTPHandler(BaseHTTPRequestHandler):
client = None
memory = None

def log_message(self, *args):
pass

def _send_json(self, code: int, data: Dict):
self.send_response(code)
self.send_header("Content-Type", "application/json; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
self.wfile.write(json.dumps(data, ensure_ascii=False).encode())

def do_GET(self):
if self.path == "/api/health":
self._send_json(200, {
"status": "ok",
"version": VERSION,
"signature": SIGNATURE,
"agents": len(SWARM.agents),
"stats": NexusHTTPHandler.client.get_stats() if NexusHTTPHandler.client else {}
})
elif self.path == "/api/cache":
self._send_json(200, CACHE.stats())
elif self.path == "/api/models":
self._send_json(200, {"models": AVAILABLE_MODELS})
else:
self._send_json(404, {"error": "Not Found"})

def do_POST(self):
length = int(self.headers.get("Content-Length", 0))
try:
body = json.loads(self.rfile.read(length).decode())
except (json.JSONDecodeError, ValueError):
self._send_json(400, {"error": "Invalid JSON"})
return

if self.path == "/api/swarm":
prompt = body.get("prompt", "")
if not prompt:
self._send_json(400, {"error": "Missing prompt"})
return

result = SWARM.run(prompt)
self._send_json(200, result)
elif self.path == "/api/chat":
prompt = body.get("prompt", "")
if not prompt:
self._send_json(400, {"error": "Missing prompt"})
return

context = NexusHTTPHandler.memory.get_context()
response = NexusHTTPHandler.client.query_with_context(prompt, context)
NexusHTTPHandler.memory.add("user", prompt)
NexusHTTPHandler.memory.add("assistant", response)

self._send_json(200, {
"response": response,
"model": NexusHTTPHandler.client.model,
"timestamp": get_timestamp()
})
elif self.path == "/api/clear":
NexusHTTPHandler.memory.clear()
self._send_json(200, {"status": "cleared"})
else:
self._send_json(404, {"error": "Not Found"})

class ThreadingHTTPServer(ThreadingMixIn, HTTPServer):
daemon_threads = True
allow_reuse_address = True

def start_server(port: int = SERVER_PORT):
client = PollinationsClient()
memory = ConversationMemory()
NexusHTTPHandler.client = client
NexusHTTPHandler.memory = memory

server = ThreadingHTTPServer(("0.0.0.0", port), NexusHTTPHandler)
print(f"{TerminalColors.GREEN}🌐 Serveur Nexus lancé sur http://localhost:{port}{TerminalColors.RESET}")
LOGGER.info(f"Server started on port {port}")
try:
server.serve_forever()
except KeyboardInterrupt:
print(f"\n{TerminalColors.YELLOW}🛑 Serveur arrêté.{TerminalColors.RESET}")
server.shutdown()

