class SwarmOrchestrator:
def __init__(self):
self.agents = [
AnalystAgent(),
CreativeAgent(),
CriticAgent(),
SecurityAgent(),
OptimizerAgent(),
SynthesizerAgent()
]
self.judge = JudgeAgent()
self.executor = ThreadPoolExecutor(max_workers=MAX_WORKERS)

def run(self, user_prompt: str) -> Dict[str, Any]:
t0 = time.time()
agent_results = []

futures = {self.executor.submit(agent.run, user_prompt): agent for agent in self.agents}
for future in as_completed(futures):
agent = futures[future]
try:
result = future.result(timeout=DEFAULT_TIMEOUT)
agent_results.append(result)
except Exception as e:
agent_results.append({
"agent": agent.name,
"response": f"[ERREUR] {str(e)[:100]}",
"duration_ms": 0,
"success": False
})

judged = self.judge.judge(user_prompt, agent_results)
total_duration = time.time() - t0

return {
"swarm_version": VERSION,
"signature": SIGNATURE,
"agents_used": [a.name for a in self.agents],
"agent_results": agent_results,
"judge_verdict": judged,
"total_duration_ms": round(total_duration * 1000, 2)
}

SWARM = SwarmOrchestrator()

